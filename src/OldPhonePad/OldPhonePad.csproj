<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OldPhonePad</RootNamespace>
    <AssemblyName>OldPhonePad</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OldPhonePad</PackageId>
    <Version>1.0.0</Version>
    <Description>Decodes multi-tap (T9-style) keypad input into text. No dependencies.</Description>
    <PackageTags>keypad;multi-tap;t9;phone;decoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
